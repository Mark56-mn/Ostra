# ---------------------------------------------------------------------------
# Ostra v0 — environment template
#
# Copy to .env.local for local development and set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real secrets.
#
# Every value below is read on the SERVER only (route handlers + agent
# runtime). Nothing here is ever exposed to the browser: the client talks to
# Ostra's own /api/* routes, never to the model endpoint directly.
# ---------------------------------------------------------------------------

# Which model provider the agent runtime uses.
#   mock = built-in simulated Ostra responses (no network, no keys)
#   http = call MODEL_API_URL over HTTP (Kaggle / VPS / OpenAI-compatible)
# If left empty, Ostra auto-selects: "http" when MODEL_API_URL is set,
# otherwise "mock".
MODEL_MODE=mock

# Full URL of the model endpoint that accepts POST requests.
# Kaggle example:  https://<id>.ngrok-free.app/generate
# OpenAI example:  https://api.openai.com/v1/chat/completions
MODEL_API_URL=

# Optional bearer token for the endpoint. Server-side only.
MODEL_API_KEY=

# Model identifier sent to the endpoint (and shown in the Ostra UI status).
MODEL_NAME=ostra-experimental

# --- Optional tuning (sensible defaults, safe to omit) ----------------------

# Request body shape:
#   openai = {"model","messages":[{"role","content"}],"temperature","max_tokens"}
#   simple = {"model","prompt","messages","temperature","max_tokens"}
MODEL_API_FORMAT=openai

# Hard timeout for a single model call, in milliseconds.
MODEL_TIMEOUT_MS=45000

# Max accepted user message length (characters).
OSTRA_MAX_MESSAGE_LENGTH=8000

# Per-IP rate limit for /api/chat (requests per window / window in seconds).
OSTRA_RATE_LIMIT_MAX=30
OSTRA_RATE_LIMIT_WINDOW=60

# ===========================================================================
# Ostra v0.2 — Provider Gateway Configuration
# ===========================================================================
# Copy this to .env.local and set the keys you need.
# Only the selected provider's key is required. Never commit real secrets.
#
# Model IDs below were verified against provider documentation on 2026-09-20.
# Free tiers change without notice — check each provider's docs before relying
# on a model or a free tier.

# --- Active provider -------------------------------------------------------
# One of: openrouter, nvidia, gemini, groq, mistral, mock
# Leave unset or set to "mock" for simulated replies during development.
AI_PROVIDER=mock

# --- Model override (optional — each provider has a verified default) ------
# AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # NVIDIA default
# AI_MODEL=nvidia/nemotron-3.5-lightning:free      # OpenRouter free default

# --- Generic key / URL overrides (optional) --------------------------------
# AI_API_KEY=
# AI_BASE_URL=

# --- Provider API keys (only the active provider needs one) ----------------
# OPENROUTER_API_KEY=   # https://openrouter.ai/keys — :free models currently $0, rate-limited
# NVIDIA_API_KEY=       # https://build.nvidia.com — free trial credits currently documented
# GEMINI_API_KEY=       # https://aistudio.google.com/apikey — free tier currently documented
# GROQ_API_KEY=         # https://console.groq.com/keys — PAID (no free tier currently documented)
# MISTRAL_API_KEY=      # https://console.mistral.ai/api-keys — PAID (credits, not a free tier)

# --- Legacy compatibility (still works) ------------------------------------
# If AI_PROVIDER is not set, these take precedence:
# MODEL_MODE=mock
# MODEL_API_URL=            # e.g. a Kaggle tunnel / VPS endpoint
# MODEL_API_KEY=
# MODEL_NAME=ostra-experimental
# MODEL_API_FORMAT=openai   # "openai" (chat/completions) or "simple"

# --- Stage 2: tools & integrations ----------------------------------------
# No tool or integration configuration is required; the registries are
# server-controlled (src/lib/tools, src/lib/integrations) and validated per
# request. On Vercel, @vercel/connect reads VERCEL_OIDC_TOKEN automatically —
# never set it manually. Vercel Connect connections are established in the
# Vercel dashboard, then appear as connected after a live probe:
#   GET /api/integrations?probe=1
# OpenRouter server tools (web_search/web_fetch/datetime/...) attach per chat
# request and are executed by OpenRouter itself; see README "Tools".

# --- Model parameters ------------------------------------------------------
MODEL_TIMEOUT_MS=60000
MODEL_MAX_TOKENS=1024
MODEL_TEMPERATURE=0.7

# --- Application limits ----------------------------------------------------
# OSTRA_MAX_MESSAGE_LENGTH=8000
# OSTRA_RATE_LIMIT_MAX=30
# OSTRA_RATE_LIMIT_WINDOW=60
